# HTTP / WebSocket port. Railway sets PORT automatically.
PORT=2567

# Comma-separated browser origins allowed to connect (CORS).
CORS_ORIGIN=http://localhost:3000

# Public URL of the Next.js app — used if the server ever needs to mint join links.
APP_BASE_URL=http://localhost:3000

# Auth0 API used to sign admin access tokens. The server verifies JWTs via JWKS.
# AUTH0_DOMAIN is the tenant host only (no https://). AUTH0_AUDIENCE is the API identifier.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://inkt.game

# Local / screenshot / bot demos: accept a shared secret instead of a real Auth0 JWT.
# NEVER enable this in production.
DEV_BYPASS_AUTH=true
DEV_ADMIN_SECRET=inkt-dev
