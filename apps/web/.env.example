# Public URL of this Next.js app (no trailing slash). Used for Auth0 redirects and QR join links.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Colyseus WebSocket URL (browser). Local: ws://localhost:2567 — Railway: wss://your-service.up.railway.app
NEXT_PUBLIC_COLYSEUS_URL=ws://localhost:2567

# tldraw production license. Optional on localhost; required for HTTPS production hosts.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Auth0 application (Regular Web Application) + API.
# AUTH0_DOMAIN is the tenant host only, e.g. your-tenant.us.auth0.com (no https://).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=https://inkt.game

# Generate AUTH0_SECRET with: openssl rand -hex 32
# Callback URL:  {APP_BASE_URL}/auth/callback
# Logout URL:    {APP_BASE_URL}
# Allowed origins: {APP_BASE_URL}

# Local demos / screenshots / bots without a live Auth0 tenant.
# Set to false in production. Must match the game server.
DEV_BYPASS_AUTH=true
DEV_ADMIN_SECRET=inkt-dev

# Optional default bot count when opening /admin?bots=
NEXT_PUBLIC_DEFAULT_BOTS=
